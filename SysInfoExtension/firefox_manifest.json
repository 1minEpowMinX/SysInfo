{
	"manifest_version": 3,
	"name": "__MSG_extName__",
	"version": "2.0.1",
	"description": "__MSG_extDesc__",
	"default_locale": "en",
	"permissions": [
		"activeTab",
		"storage",
		"scripting"
	],
	"host_permissions": [
		"http://localhost:8734/*",
		"https://jira.company.local/*",
		"https://jira-t.company.local/*",
		"https://jira-t2.company.local/*"
	],
	"action": {
		"default_popup": "popup/popup.html",
		"default_icon": "assets/sysinfo_ext.svg"
	},
	"icons": {
		"48": "assets/sysinfo_ext.svg"
	},
	"content_scripts": [
		{
			"matches": [
				"https://jira.company.local/*",
				"https://jira-t.company.local/*",
				"https://jira-t2.company.local/*"
			],
			"js": [
				"content/content_script.bundle.js"
			],
			"css": [
				"content/toast.css"
			]
		}
	],
	"background": {
		"scripts": [
			"background/service_worker.js"
		]
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "sysinfo-addon@company.local",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": [
					"browsingActivity",
					"websiteContent"
				]
			}
		}
	}
}