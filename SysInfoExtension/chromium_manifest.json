{
	"manifest_version": 3,
	"name": "__MSG_extName__",
	"version": "2.1.0",
	"description": "__MSG_extDesc__",
	"default_locale": "en",
	"permissions": [
		"activeTab",
		"storage",
		"scripting"
	],
	"host_permissions": [
		"http://localhost:8734/*",
		"https://jira.company.local/*",
		"https://jira-t.company.local/*",
		"https://jira-t2.company.local/*"
	],
	"action": {
		"default_popup": "popup/popup.html",
		"default_icon": {
			"16": "assets/icons/sysinfo_ext_16.png",
			"24": "assets/icons/sysinfo_ext_24.png",
			"32": "assets/icons/sysinfo_ext_32.png",
			"48": "assets/icons/sysinfo_ext_48.png"
		}
	},
	"icons": {
		"16": "assets/icons/sysinfo_ext_16.png",
		"32": "assets/icons/sysinfo_ext_32.png",
		"48": "assets/icons/sysinfo_ext_48.png",
		"128": "assets/icons/sysinfo_ext_128.png"
	},
	"content_scripts": [
		{
			"matches": [
				"https://jira.company.local/*",
				"https://jira-t.company.local/*",
				"https://jira-t2.company.local/*"
			],
			"js": [
				"content/content_script.bundle.js"
			],
			"css": [
				"content/toast.css"
			]
		}
	],
	"background": {
		"service_worker": "background/service_worker.js"
	}
}