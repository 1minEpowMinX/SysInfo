{
	"manifest_version": 3,
	"name": "__MSG_extName__",
	"version": "${version}",
	"description": "__MSG_extDesc__",
	"default_locale": "en",
	"permissions": [
		"activeTab",
		"storage",
		"scripting"
	],
	"host_permissions": "${hostPermissions}",
	"action": {
		"default_popup": "popup/popup.html",
		"default_icon": {
			"16": "assets/icons/sysinfo_ext_16.png",
			"24": "assets/icons/sysinfo_ext_24.png",
			"32": "assets/icons/sysinfo_ext_32.png",
			"48": "assets/icons/sysinfo_ext_48.png",
			"64": "assets/icons/sysinfo_ext_64.png"
		}
	},
	"icons": {
		"16": "assets/icons/sysinfo_ext_16.png",
		"32": "assets/icons/sysinfo_ext_32.png",
		"48": "assets/icons/sysinfo_ext_48.png",
		"64": "assets/icons/sysinfo_ext_64.png",
		"128": "assets/icons/sysinfo_ext_128.png"
	},
	"background": {
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": "${contentMatches}",
			"js": [
				"content/content_script.bundle.js"
			],
			"css": [
				"content/toast.css"
			]
		}
	]
}
