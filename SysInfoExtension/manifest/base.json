{
	"manifest_version": 3,
	"name": "__MSG_extName__",
	"version": "${version}",
	"description": "__MSG_extDesc__",
	"default_locale": "en",
	"permissions": [
		"activeTab",
		"storage",
		"scripting"
	],
	"host_permissions": "${hostPermissions}",
	"action": {
		"default_popup": "popup/popup.html"
	},
	"background": {
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": "${contentMatches}",
			"js": [
				"content/content_script.bundle.js"
			],
			"css": [
				"content/toast.css"
			]
		}
	]
}
