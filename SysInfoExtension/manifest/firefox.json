{
	"action": {
		"default_icon": "assets/icons/sysinfo_ext.svg"
	},
	"icons": {
		"48": "assets/icons/sysinfo_ext.svg"
	},
	"background": {
		"scripts": [
			"background/service_worker.js"
		]
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "${geckoId}",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": [
					"browsingActivity",
					"websiteContent"
				]
			}
		}
	}
}
