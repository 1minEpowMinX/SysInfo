#include <windows.h>

IDI_ICON1 ICON "icons/SysInfo_Icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Pivdenny\0"
            VALUE "FileDescription", "SysInfo\0"
            VALUE "FileVersion", "2.0.0.0\0"
            VALUE "InternalName", "SysInfo\0"
            VALUE "LegalCopyright", "\xA9 github.com/1minEpowMinX. All rights reserved.\0" // "\xA9" – ©
            VALUE "OriginalFilename", "SysInfo.exe\0"
            VALUE "ProductName", "SysInfo\0"
            VALUE "ProductVersion", "2.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // en-US, ru-RU, uk-UA, all is Unicode UTF-16
        VALUE "Translation", 0x0409, 1200, 0x0419, 1200, 0x0422, 1200
    END
END
