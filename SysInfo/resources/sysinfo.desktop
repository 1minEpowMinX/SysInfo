[Desktop Entry]
Type=Application
# An optional Version key states the revision of the specification the entry
# conforms to, never the version of the application.
Name=SysInfo
Comment=Collects and displays system information
Exec=/opt/SysInfo/SysInfo
Icon=sysinfo
Terminal=false
Categories=Utility;System;
StartupNotify=true
X-GNOME-Autostart-enabled=true
Hidden=false
